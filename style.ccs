* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Oswald', sans-serif;
    background: #050505;
    color: white;
    overflow: hidden;
}

.hero {
    position: relative;
    width: 100%;
    height: 100vh;
    background:
        radial-gradient(circle at center, rgba(200,16,46,0.35) 0%, rgba(5,5,5,0.95) 70%),
        linear-gradient(135deg, #0a0a0a 0%, #000000 100%);
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Effet fumée rouge */
.hero::before,
.hero::after {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.25;
}

.hero::before {
    background: #c8102e;
    top: -150px;
    left: -150px;
}

.hero::after {
    background: #ff1f3d;
    bottom: -150px;
    right: -150px;
}

.overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(rgba(0,0,0,0.25), rgba(0,0,0,0.75)),
        radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.45) 100%);
}

.content {
    position: relative;
    z-index: 2;
    text-align: center;
    animation: fadeIn 1.2s ease;
}

h1 {
    font-size: 4.2rem;
    letter-spacing: 4px;
    margin-bottom: 35px;
    text-transform: uppercase;
    font-weight: 700;
    text-shadow: 0 0 20px rgba(255,255,255,0.08);
}

h1 span {
    color: #c8102e;
}

.logo {
    width: 360px;
    max-width: 80%;
    margin-bottom: 45px;
    filter: drop-shadow(0 0 30px rgba(200,16,46,0.45));
    transition: transform 0.3s ease;
}

.logo:hover {
    transform: scale(1.03);
}

.btn {
    display: inline-block;
    padding: 18px 48px;
    border: 2px solid #c8102e;
    border-radius: 14px;
    color: white;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 2px;
    background: rgba(0,0,0,0.55);
    box-shadow: 0 0 25px rgba(200,16,46,0.35);
    transition: all 0.3s ease;
}

.btn:hover {
    background: #c8102e;
    box-shadow: 0 0 35px rgba(200,16,46,0.8);
    transform: translateY(-3px);
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 768px) {
    h1 {
        font-size: 2.6rem;
    }

    .logo {
        width: 260px;
    }

    .btn {
        font-size: 1rem;
        padding: 16px 34px;
    }
}
